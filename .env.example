# Optional server-only model settings. Never prefix secrets with NEXT_PUBLIC_.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Enable conversation, market data, news and integrated diagnosis.
ENABLE_CHAT_PREVIEW=true
# Get a separate server-side key at https://fuyao.aicubes.cn/admin
FUYAO_API_KEY=
# iFinD MCP personal token, separate from Fuyao. https://mcp.51ifind.com/
IFIND_API_KEY=
# Local development uses fetch; Sites production uses direct-tls.
IFIND_TRANSPORT=fetch
